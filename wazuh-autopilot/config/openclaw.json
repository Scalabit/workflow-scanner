{
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": ["*"],
      "dangerouslyAllowHostHeaderOriginFallback": true,
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "env": {
    "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
  },
  "models": {
    "mode": "replace",
    "providers": {
      "ollama": {
        "baseUrl": "http://localhost:11434",
        "apiKey": "ollama-local",
        "api": "ollama",
        "models": [
          {
            "id": "qwen2.5:0.5b",
            "name": "qwen2.5:0.5b",
            "contextWindow": 32768,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-haiku-4-5",
        "fallbacks": ["ollama/qwen2.5:0.5b"]
      }
    }
  },
  "hooks": {
    "enabled": true,
    "token": "HOOKS_TOKEN_PLACEHOLDER",
    "path": "/hooks",
    "mappings": [
      {
        "id": "wazuh-alert",
        "match": { "path": "wazuh-alert" },
        "action": "agent",
        "agentId": "main",
        "name": "Wazuh Security Alert",
        "messageTemplate": "WAZUH SECURITY ALERT\n\nRule: {{rule.description}}\nLevel: {{rule.level}}\nFull Alert:\n{{.}}",
        "deliver": true
      }
    ]
  }
}
