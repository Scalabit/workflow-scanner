{
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": ["*"],
      "dangerouslyAllowHostHeaderOriginFallback": true,
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "browser": {
    "ssrfPolicy": {
      "dangerouslyAllowPrivateNetwork": true
    }
  },
  "tools": {
    "web": {
      "dangerouslyAllowInternalDestinations": true
    }
  },
  "env": {
    "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
  },
  "models": {
    "mode": "replace",
    "providers": {
      "ollama": {
        "baseUrl": "http://localhost:11434",
        "apiKey": "ollama-local",
        "api": "ollama",
        "models": [
          {
            "id": "qwen2.5:0.5b",
            "name": "qwen2.5:0.5b",
            "contextWindow": 32768,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/qwen2.5:0.5b",
        "fallbacks": ["anthropic/claude-haiku-4-5"]
      }
    },
    "list": [
      {
        "id": "wazuh-triage",
        "name": "Wazuh Alert Triage",
        "default": true,
        "workspace": "/var/lib/openclaw/wazuh-autopilot/agents/triage",
        "agentDir": "/var/lib/openclaw/wazuh-autopilot/agents/triage",
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["read", "edit", "web_fetch", "sessions_list", "sessions_history"],
          "deny": ["write", "exec", "delete", "browser"]
        },
        "heartbeat": { "every": "10m" }
      },
      {
        "id": "wazuh-correlation",
        "name": "Wazuh Incident Correlation",
        "workspace": "/var/lib/openclaw/wazuh-autopilot/agents/correlation",
        "agentDir": "/var/lib/openclaw/wazuh-autopilot/agents/correlation",
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["read", "edit", "web_fetch", "sessions_list", "sessions_history"],
          "deny": ["write", "exec", "delete", "browser"]
        },
        "heartbeat": { "every": "5m" }
      }
    ]
  },
  "hooks": {
    "enabled": true,
    "token": "HOOKS_TOKEN_PLACEHOLDER",
    "path": "/webhook",
    "mappings": [
      {
        "id": "wazuh-alert",
        "match": { "path": "wazuh-alert" },
        "action": "agent",
        "agentId": "wazuh-triage",
        "name": "Wazuh Alert Triage",
        "messageTemplate": "WAZUH SECURITY ALERT\n\nRule: {{rule.description}}\nLevel: {{rule.level}}\nFull Alert:\n{{.}}",
        "deliver": true
      }
    ]
  }
}
